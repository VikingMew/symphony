# Copy to .env, replace every required/change-me value, and keep .env private.
POSTGRES_DB=symphony
POSTGRES_USER=symphony
POSTGRES_PASSWORD=change-me-use-a-long-random-value
DATABASE_URL=postgresql://symphony:change-me-use-a-long-random-value@postgres:5432/symphony
SYMPHONY_DATABASE_POOL_SIZE=10

# Dashboard and execution mode
SYMPHONY_DASHBOARD_BIND=127.0.0.1
SYMPHONY_DASHBOARD_PORT=4000
SYMPHONY_EXECUTION_MODE=centralized

# Linear and Codex/OpenAI
LINEAR_API_KEY=
LINEAR_ASSIGNEE=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# GitHub: use one token variable, or authenticate gh in the gh_config volume.
GH_TOKEN=
GITHUB_TOKEN=

# Dashboard/API auth. Set a password or a precomputed password hash.
SYMPHONY_AUTH_ENABLED=true
SYMPHONY_ADMIN_USERNAME=admin
SYMPHONY_ADMIN_PASSWORD=change-me-use-a-different-long-random-value
SYMPHONY_ADMIN_PASSWORD_HASH=
SECRET_KEY_BASE=change-me-use-at-least-64-random-bytes-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Worker, SSH, reverse-proxy, and public URL settings
SYMPHONY_WORKER_REGISTRATION_TOKEN=
SYMPHONY_SSH_CONFIG=
SYMPHONY_TRUST_X_FORWARDED_HEADERS=false
SYMPHONY_PUBLIC_URL=

# Optional outbound proxy settings inherited by Symphony and child Codex/gh.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=postgres,localhost,127.0.0.1
http_proxy=
https_proxy=
all_proxy=
no_proxy=postgres,localhost,127.0.0.1

# Opt-in trusted HTTP execution worker. Keep its credentials distinct from Panel credentials.
# Use a release tag containing the full source revision or, preferably, an immutable digest.
SYMPHONY_EXECUTION_WORKER_IMAGE=symphony-execution-worker:8e5f7fead76fe82fab6c72ac4e637cea8a1e23b2
SYMPHONY_EXECUTION_WORKER_SOURCE_REVISION=8e5f7fead76fe82fab6c72ac4e637cea8a1e23b2
SYMPHONY_EXECUTION_WORKER_NAME=compose-execution-worker
SYMPHONY_EXECUTION_WORKER_SLOTS=1
SYMPHONY_EXECUTION_WORKER_RETENTION_SECONDS=86400
SYMPHONY_EXECUTION_WORKER_CACHE_MAX_BYTES=10737418240
SYMPHONY_EXECUTION_WORKER_OPENAI_API_KEY=
SYMPHONY_EXECUTION_WORKER_OPENAI_BASE_URL=
SYMPHONY_EXECUTION_WORKER_GH_TOKEN=
SYMPHONY_EXECUTION_WORKER_RESTRICTED_LINEAR_TOKEN=
SYMPHONY_EXECUTION_WORKER_RESTRICTED_LINEAR_URL=
SYMPHONY_EXECUTION_WORKER_HTTP_PROXY=
SYMPHONY_EXECUTION_WORKER_HTTPS_PROXY=
SYMPHONY_EXECUTION_WORKER_NO_PROXY=symphony,localhost,127.0.0.1
